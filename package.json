{
  "name": "kempo-inventory",
  "version": "0.2.2",
  "description": "A basic inventory management system for kempo cms",
  "license": "MIT",
  "author": "Dustin Poissant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-inventory.git"
  },
  "bugs": {
    "url": "https://github.com/dustinpoissant/kempo-inventory/issues"
  },
  "homepage": "https://github.com/dustinpoissant/kempo-inventory#readme",
  "type": "module",
  "main": "sdk.js",
  "scripts": {
    "test": "node --test",
    "link:local": "npm install ../kempo --no-save"
  },
  "kempo": {
    "public-scope": "inventory"
  },
  "exports": {
    "./install": "./install.js",
    "./update": "./update.js",
    "./sdk": "./sdk.js"
  },
  "files": [
    "admin",
    "public",
    "server",
    "install.js",
    "update.js",
    "sdk.js",
    "kempo-config.json"
  ],
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "kempo": ">=4.3.0",
    "kempo-ui": ">=0.5.0",
    "kempo-media": ">=0.2.3",
    "kempo-files": ">=0.1.3",
    "kempo-thumbs": ">=0.1.3"
  },
  "peerDependenciesMeta": {
    "kempo-media": {
      "optional": true
    },
    "kempo-files": {
      "optional": true
    },
    "kempo-thumbs": {
      "optional": true
    }
  }
}
