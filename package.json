{
  "name": "kempo-inventory",
  "version": "0.3.5",
  "description": "A basic inventory management system for kempo cms",
  "license": "MIT",
  "author": "Dustin Poissant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-inventory.git"
  },
  "bugs": {
    "url": "https://github.com/dustinpoissant/kempo-inventory/issues"
  },
  "homepage": "https://github.com/dustinpoissant/kempo-inventory#readme",
  "type": "module",
  "main": "sdk.js",
  "scripts": {
    "test": "node scripts/run-tests.js unit node --test --test-concurrency=1",
    "test:integration": "node scripts/run-tests.js integration node --test --test-concurrency=1",
    "link:local": "npm install ../kempo ../kempo-server ../kempo-ui --no-save --no-legacy-peer-deps --force",
    "docs:build": "node scripts/build-docs.js",
    "docs:dev": "npx kempo-server --root docs --port 4050"
  },
  "exports": {
    "./install": "./install.js",
    "./update": "./update.js",
    "./sdk": "./sdk.js"
  },
  "files": [
    "admin",
    "public",
    "server",
    "install.js",
    "update.js",
    "sdk.js",
    "kempo-config.json"
  ],
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "kempo": ">=4.5.8",
    "kempo-ui": ">=0.5.0",
    "kempo-media": ">=0.3.0",
    "kempo-files": ">=0.1.3",
    "kempo-thumbs": ">=0.1.3"
  },
  "peerDependenciesMeta": {
    "kempo-media": {
      "optional": true
    },
    "kempo-files": {
      "optional": true
    },
    "kempo-thumbs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "highlight.js": "^11.11.1"
  }
}
